VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Calendar sync (ver src/lib/googleCalendar.js). El Client ID es
# público (va en la URL de consentimiento armada en el navegador); el
# Client Secret NUNCA va acá, solo como secret de la Edge Function
# google-calendar en Supabase (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# GOOGLE_REDIRECT_URI — este último debe ser exactamente
# "<tu dominio>/calendar/callback" y estar agregado como Authorized
# redirect URI en el OAuth Client de Google Cloud Console).
VITE_GOOGLE_CLIENT_ID=
